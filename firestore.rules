rules_version = '2';

// TripCash access rules. One document per trip (ADR-0009); the document's
// own memberUids list decides who may touch it, and invitedEmails decides
// who may join it (ADR-0010).
//
// Paste this into the Firebase console:
//   Firestore → Rules tab → replace everything → Publish.
//
// Default-deny is the point: anything not matched below is refused, so a
// new collection added later is locked until its rule is written.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    // An invite is honoured only for a VERIFIED address. Without that
    // check anyone could register with email/password using someone
    // else's address and walk straight into their trip.
    // `.get(key, default)` keeps this safe on trip documents written
    // before invites existed, which have no invitedEmails field at all.
    function isInvited() {
      return signedIn()
             && request.auth.token.get('email_verified', false) == true
             && request.auth.token.get('email', '') != ''
             && request.auth.token.get('email', '').lower()
                in resource.data.get('invitedEmails', []);
    }

    // No write may drop someone who is already on the trip.
    function keepsEveryone() {
      return request.resource.data.memberUids.hasAll(resource.data.memberUids);
    }

    match /trips/{tripId} {
      // `resource` is null when the document doesn't exist yet, and every
      // sync opens by reading the trip inside a transaction — including
      // the first sync of a brand-new trip. Without the null case no trip
      // could ever be created.
      allow get: if signedIn() && (resource == null || isMember() || isInvited());

      // Querying still demands membership or an invite, so a signed-in
      // stranger can never enumerate anyone else's trips.
      allow list: if isMember() || isInvited();

      // Creating a trip requires putting yourself on the list — you
      // cannot create a document you would then be unable to read.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.memberUids;

      // Members edit freely. An invited person may write only to add
      // themselves — and nobody, member or invitee, may evict anyone.
      allow update: if (isMember() || isInvited())
                    && request.auth.uid in request.resource.data.memberUids
                    && keepsEveryone();

      allow delete: if isMember();
    }
  }
}
