rules_version = '2';

// TripCash access rules. One document per trip (ADR-0009); the document's
// own memberUids list decides who may touch it, and invitedEmails decides
// who may join it (ADR-0010).
//
// Paste this into the Firebase console:
//   Firestore → Rules tab → replace everything → Publish.
//
// Default-deny is the point: anything not matched below is refused, so a
// new collection added later is locked until its rule is written.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    function myEmail() {
      return request.auth.token.get('email', '').lower().trim();
    }

    // Your address is on the trip's invite list. `.get(key, default)`
    // keeps this safe on trip documents written before invites existed.
    //
    // No email-verification requirement here on purpose: reaching a trip
    // this way means already knowing its id, which only comes from the
    // invite link someone sent you privately. The link is the secret;
    // the email match is the second check. Requiring verification as
    // well made invites depend on transactional email actually being
    // delivered, which stranded a real invitee.
    //
    // BUT that reasoning justifies READ and JOIN only. It does not
    // justify write access, and it must not — invitedEmails is derived
    // from members, so it contains the address of every CURRENT member,
    // not just people with an invitation outstanding. Anyone able to
    // register an account (unverified) with a member's address and who
    // has the trip id could otherwise rewrite or destroy the whole
    // trip. See joinOnly() below.
    function isInvited() {
      return signedIn() && myEmail() != ''
             && myEmail() in resource.data.get('invitedEmails', []);
    }

    // The ONLY write an invitee may make: add themselves to memberUids
    // and change nothing else. Every other field must come back byte
    // for byte. Deleting a trip this way is impossible — `deleted` is
    // covered by the unchanged() list.
    // `.get(f, null)` on both sides means "absent" compares equal to
    // "absent", so a field neither side has is unchanged.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function joinOnly() {
      return unchanged('trip') && unchanged('expenses') && unchanged('settlements')
             && unchanged('tombstones') && unchanged('deleted') && unchanged('deletedAt')
             && unchanged('ownerUid') && unchanged('invitedEmails')
             && unchanged('schema') && unchanged('lastEditBy');
    }

    // Your own invite key: the sha-256 of your address, lowercased to
    // match how invitedEmails is stored.
    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    function myEmailKey() {
      return hashing.sha256(myEmail()).toHexString().lower();
    }

    // No write may drop someone who is already on the trip.
    //
    // This applies to INVITEES ONLY now. It used to apply to members too,
    // and between it and the client's growing union, removing somebody
    // was impossible: their row left the members sheet while they kept
    // full write on the document — every expense readable, the ledger
    // rewritable, the trip tombstonable — and the notification function
    // kept pushing every change to their phone (TC-4). An invitee still
    // may not drop anyone: their single permitted write is adding
    // themselves, and nothing about being invited earns a say in who else
    // is on the trip.
    function keepsEveryone() {
      return request.resource.data.memberUids.hasAll(resource.data.memberUids);
    }

    // …with one exception that is not the members' to make: the owner.
    //
    // Everyone else can be removed and invited back. The owner is who
    // makes that possible, so they are the one uid no write may drop —
    // otherwise the last person left holding the trip can be locked out
    // of it by anyone else on it, permanently, with no way back.
    //
    // ownerUid is pinned for the same reason: without it, seizing it and
    // then evicting the real owner is two ordinary writes.
    //
    // The pin is on the FIELD, unconditionally — an update may not change
    // ownerUid, in either direction, ever. It used to short-circuit to
    // true whenever the STORED document had no owner, which was meant to
    // keep trips written before ownerUid existed writable and instead
    // handed them away: on such a trip any member could name themselves
    // owner in one ordinary background push, be pinned by this very
    // function, and evict the person who created the trip with a second.
    // The rule protecting the owner was protecting whoever synced first
    // (TC2-3, ADR-0023).
    //
    // Nothing here can tell an owner from an impostor on a document that
    // never recorded one, so nothing here guesses: an ownerless trip stays
    // ownerless, and stays an ordinary trip its members can rename, spend
    // on and remove each other from. `.get(f, null)` on both sides means
    // absent, null and unwritten all compare equal — so a client that has
    // never heard of ownerUid keeps working, and one that has can send the
    // stored value straight back.
    function keepsOwner() {
      return request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
             && (resource.data.get('ownerUid', null) == null
                 || resource.data.ownerUid in request.resource.data.memberUids);
    }

    // Creation is the one moment an owner can legitimately appear, because
    // it is the one moment we know there is no owner to displace: there is
    // no document. It must be YOU — pinning ownerUid on update buys
    // nothing if a device can simply create the document naming somebody
    // else. Absent is still allowed: that is what an old client uploads,
    // and refusing it breaks a device we would rather keep working.
    function ownsWhatItCreates() {
      return request.resource.data.get('ownerUid', null) == null
             || request.resource.data.ownerUid == request.auth.uid;
    }

    // Counting (ADR: docs/design/INSTRUMENTATION.md). Written ONLY by
    // the Cloud Function via the admin SDK, which bypasses rules — so
    // the client is denied both ways. There is nothing per-person in
    // here, but a readable funnel is still somebody else's business.
    match /stats/{day} {
      allow read, write: if false;
    }

    // Trips someone has invited you to, addressed by the hash of YOUR
    // OWN address (ADR-0020).
    //
    // This is the whole point of the design: a read of a document keyed
    // by your own identity has no filter for the rules engine to prove,
    // so it cannot be refused for a reason the client can't see — which
    // is what made the previous query fail invisibly. No verification
    // needed; nothing to enumerate.
    //
    // Anyone signed in may WRITE an entry, because you must be able to
    // invite someone whose account you cannot read. That is safe: the
    // index only hands out trip ids, and every one of them is still
    // fetched through `allow get` above, which checks isInvited(). A
    // stranger stuffing your invite document gains them nothing.
    match /invites/{key} {
      allow read, delete: if signedIn() && key == myEmailKey();
      // `write` covers create/update/DELETE, so granting it to any
      // signed-in user overrode the ownership check above and let a
      // stranger empty — or hard-delete — somebody else's index. Every
      // invitation waiting for them would vanish with nothing to report,
      // which is precisely the failure ADR-0020 exists to remove.
      //
      // Create and update only, and a STRANGER's update may only ADD
      // trips.
      //
      // The owner of the key is exempt, and has to be. Spending an
      // invitation is the app's own cleanup — dropInvites() writes
      // `{trips: {<id>: deleteField()}}` with merge:true — and
      // hasAll(...) is false the instant a key is removed, so every one
      // of those writes was refused. The refusal was swallowed at the
      // call site, so the only visible symptom was that an invitation
      // which can never succeed (deleted trip, wrong address) came back
      // on every sync for the full ninety-day TTL.
      //
      // Exempting them gives away nothing: `allow delete` above already
      // lets the owner destroy this whole document, so forbidding them a
      // partial removal protected precisely nobody. The hasAll guard is
      // still doing its real job — stopping a STRANGER from emptying the
      // index and silently deleting every invitation waiting for you,
      // which is the failure ADR-0020 exists to remove.
      allow create: if signedIn();
      allow update: if signedIn()
                    && (key == myEmailKey()
                        || request.resource.data.trips.keys().hasAll(resource.data.trips.keys()));
    }

    // Your own preferences — home currency, which trip is pinned, the
    // street-rate markup. Nobody else's business, and nobody else's to
    // read: strictly your own uid, both ways.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      // `resource` is null when the document doesn't exist yet, and every
      // sync opens by reading the trip inside a transaction — including
      // the first sync of a brand-new trip. Without the null case no trip
      // could ever be created.
      allow get: if signedIn() && (resource == null || isMember() || isInvited());

      // Only your own trips. Searching by invited address used to be
      // permitted for a VERIFIED invitee — that query is gone (ADR-0020)
      // and with it the verification gate that silently stranded a real
      // user twice. Discovery is now a read of invites/{yourKey}.
      allow list: if isMember();

      // Creating a trip requires putting yourself on the list — you
      // cannot create a document you would then be unable to read — and
      // any owner it names has to be you (ownsWhatItCreates).
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.memberUids
                    && ownsWhatItCreates();

      // Members edit freely, INCLUDING taking somebody off the trip —
      // see keepsEveryone() for why that used to be forbidden and what
      // the ban actually cost. An invited person may write only to add
      // themselves, and may still evict nobody.
      //
      // Two limits survive for every writer: the write must leave its own
      // author on the list (below), and it must leave the owner on it
      // (keepsOwner). Everything else about membership is the members'
      // business.
      //
      // The second clause used to be a comment rather than a rule: an
      // invitee had unrestricted write to every field except memberUids,
      // which meant an unverified account holding a leaked invite link
      // could tombstone the trip for everybody. joinOnly() enforces it.
      // joinOnly() only ever gated the FIRST write — the join itself
      // puts you in memberUids, so from the second write isMember() is
      // true and everything is permitted. An unverified account
      // registered on any member's address, plus a forwarded invite
      // link, could therefore rewrite the ledger or tombstone the trip
      // for everybody.
      //
      // So joining requires a VERIFIED address. Reading and being
      // invited do not — discovery stays open (ADR-0020), and this is a
      // deliberate action the app can explain when it is blocked, which
      // is what made the old verification gate unbearable: it refused a
      // QUERY, silently, with no way to report why.
      allow update: if request.auth.uid in request.resource.data.memberUids
                    && keepsOwner()
                    && (isMember()
                        || (isInvited() && emailVerified() && joinOnly() && keepsEveryone()));

      // Only a member may destroy the document outright. In practice the
      // app never does this — deleting a trip REPLACES it with a
      // tombstone (ADR-0013) so the delete can travel. A hard delete
      // would drop the ACL with it, letting anyone who knows the id
      // recreate the trip with themselves as its only member.
      allow delete: if false;

    }
  }
}
